CREATE TABLE pending_operation (
    id TEXT NOT NULL PRIMARY KEY,
    store_id TEXT NOT NULL,
    entity_type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    operation_type TEXT NOT NULL,
    state TEXT NOT NULL,
    retry_count INTEGER NOT NULL DEFAULT 0,
    next_attempt_at INTEGER,
    last_error TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectPending:
SELECT * FROM pending_operation WHERE state IN ('PENDING', 'FAILED') AND (next_attempt_at IS NULL OR next_attempt_at <= ?)
ORDER BY created_at ASC;

insert:
INSERT OR REPLACE INTO pending_operation(id, store_id, entity_type, entity_id, operation_type, state, retry_count, next_attempt_at, last_error, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateState:
UPDATE pending_operation SET state = ?, retry_count = ?, next_attempt_at = ?, last_error = ?, updated_at = ? WHERE id = ?;

deleteById:
DELETE FROM pending_operation WHERE id = ?;
