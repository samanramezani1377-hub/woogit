CREATE TABLE order_entity (
    id TEXT NOT NULL PRIMARY KEY,
    store_id TEXT NOT NULL,
    status TEXT NOT NULL,
    total_minor_units INTEGER NOT NULL,
    currency TEXT NOT NULL,
    version TEXT NOT NULL,
    modified_at TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectById:
SELECT * FROM order_entity WHERE id = ?;

selectByStore:
SELECT * FROM order_entity WHERE store_id = ? ORDER BY updated_at DESC;

upsert:
INSERT OR REPLACE INTO order_entity(id, store_id, status, total_minor_units, currency, version, modified_at, payload_json, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM order_entity WHERE id = ?;
