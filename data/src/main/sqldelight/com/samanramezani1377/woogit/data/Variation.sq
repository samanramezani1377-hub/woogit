CREATE TABLE variation_entity (
    id TEXT NOT NULL PRIMARY KEY,
    product_id TEXT NOT NULL,
    store_id TEXT NOT NULL,
    status TEXT NOT NULL,
    price_minor_units INTEGER,
    stock_quantity INTEGER,
    payload_json TEXT NOT NULL,
    version TEXT NOT NULL,
    modified_at TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE attribute_entity (
    id TEXT NOT NULL PRIMARY KEY,
    store_id TEXT NOT NULL,
    product_id TEXT,
    name TEXT NOT NULL,
    value TEXT NOT NULL,
    scope TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectVariationsByProduct:
SELECT * FROM variation_entity WHERE product_id = ? ORDER BY updated_at DESC;

upsertVariation:
INSERT OR REPLACE INTO variation_entity(id, product_id, store_id, status, price_minor_units, stock_quantity, payload_json, version, modified_at, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertAttribute:
INSERT OR REPLACE INTO attribute_entity(id, store_id, product_id, name, value, scope, payload_json, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);
